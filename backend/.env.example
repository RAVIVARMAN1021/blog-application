# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# Note: If no external MongoDB instance is running, an embedded memory database will start automatically for development.
MONGO_URI=mongodb://127.0.0.1:27017/blogverse

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Frontend Client Origin (for CORS policy)
CLIENT_URL=http://localhost:8080
